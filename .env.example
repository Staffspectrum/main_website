# ==============================================================================
# Staff Spectrum Environment Configuration Template
# COPY THIS FILE TO .env.local FOR LOCAL DEVELOPMENT
# DO NOT COMMIT ACTUAL PASSWORDS OR PRODUCTION SECRETS TO VERSION CONTROL
# ==============================================================================

# Database: Isolated PostgreSQL Database for Staff Spectrum Next.js
# NOTE: MUST be a distinct database, completely isolated from any existing Django database!
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL="postgresql://staffspectrum_user:CHANGE_ME_DATABASE_PASSWORD@127.0.0.1:5432/staffspectrum_next?schema=public"

# Connection pool limit (Kept low to protect 1 GB RAM VPS)
DB_POOL_MAX="3"

# SSL Setting for DigitalOcean App Platform / Managed Databases ("true" enables SSL)
DATABASE_SSL="false"
DATABASE_SSL_REJECT_UNAUTHORIZED="false"

# SMTP Mail Server Configuration
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="notifications@example.com"
SMTP_PASS="CHANGE_ME_SMTP_PASSWORD"

# Email Addresses & Notification Routing
EMAIL_FROM="Staff Spectrum <no-reply@staff-spectrum.com>"
CONTACT_NOTIFICATION_EMAIL="info@staff-spectrum.com"
CONTACT_EMPLOYER_EMAIL="info@staff-spectrum.com"
CONTACT_HR_EMAIL="Hr@staff-spectrum.com"

# Security & Abuse Protection
# Secret salt used for HMAC hashing of client IP addresses (prevents storing raw IPs)
IP_HASH_SALT="CHANGE_ME_RANDOM_SECRET_SALT_FOR_IP_HASHING"

# Object Storage: Cloudflare R2 (S3-compatible, host-agnostic persistent resume storage)
# Works identically across Ubuntu VPS and DigitalOcean App Platform
R2_ACCOUNT_ID="CHANGE_ME_CLOUDFLARE_ACCOUNT_ID"
R2_ACCESS_KEY_ID="CHANGE_ME_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="CHANGE_ME_R2_SECRET_ACCESS_KEY"
R2_BUCKET_NAME="staffspectrum-resumes-private"
R2_ENDPOINT="https://CHANGE_ME_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com"

# Admin Authentication & Session Security
# MANDATORY: 256-bit cryptographically secure secret used for signing admin JWT sessions.
# Must be at least 32 characters long in all environments where admin panel is accessed.
# Generate on Linux/Mac: openssl rand -hex 32
ADMIN_JWT_SECRET="CHANGE_ME_GENERATE_RANDOM_SECRET_KEY_MINIMUM_32_CHARACTERS"

# Initial Admin Provisioning (Optional CLI inputs - avoid committing real values)
# Run `npm run admin:create` interactively, or set these temporarily during setup:
# INITIAL_ADMIN_EMAIL="admin@staffspectrum.com"
# INITIAL_ADMIN_NAME="Administrator"
# INITIAL_ADMIN_PASSWORD="CHANGE_ME_MIN_10_CHARS_UPPER_LOWER_DIGIT"


